# Google C++ style with a 120-character line limit and 4-space indentation.
# The container pins clang-format to the host's version (see Containerfile).
BasedOnStyle: Google
ColumnLimit: 120
IndentWidth: 4
# Keep public:/private: flush with the class keyword.
AccessModifierOffset: -4
# Google's default derives pointer alignment from the file; make it fixed.
DerivePointerAlignment: false
PointerAlignment: Left
